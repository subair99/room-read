# Copy to .env.local for local dev. Never commit real values.
# On the host, set these as secrets instead.

# Qloo event credential (or run `qloo setup --qloo` locally instead)
QLOO_API_KEY=

# Path to the qloo binary if it isn't on PATH (desktop apps often have a short PATH)
QLOO_BIN=qloo

# LLM provider: "anthropic" or "azure"
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# Azure OpenAI (only if LLM_PROVIDER=azure)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Cache and guardrails
CACHE_PATH=data/cache.db
CACHE_TTL_HOURS=72
RATE_LIMIT_PER_MINUTE=20
