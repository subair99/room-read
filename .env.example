# Copy to .env.local for local dev. Never commit real values.
# On the host, set these as secrets instead.

# --- Qloo ---
# Locally, `qloo setup --qloo` and `qloo config set base-url ...` store these for you.
# On a server, set all three as environment variables.
QLOO_API_KEY=
# Hackathon keys only work against this server
QLOO_BASE_URL=https://hackathon.api.qloo.com/
QLOO_TRUSTED_BASE_URL=https://hackathon.api.qloo.com/
# Path to the qloo binary if it isn't on PATH
QLOO_BIN=qloo

# --- LLM (language work only; Qloo makes every judgment) ---
# "openai-compatible" (Qwen, OpenRouter, Together, Nebius...), "anthropic" or "azure"
LLM_PROVIDER=openai-compatible

# OpenAI-compatible, e.g. Qwen via Alibaba Cloud Model Studio
LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-plus

# Anthropic (if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-sonnet-5-5

# Azure OpenAI (if LLM_PROVIDER=azure)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Cache and guardrails ---
CACHE_PATH=data/cache.db
CACHE_TTL_HOURS=72
RATE_LIMIT_PER_MINUTE=20
# Per-call Qloo timeout and how many Qloo calls run at once
QLOO_TIMEOUT_MS=25000
QLOO_CONCURRENCY=3
